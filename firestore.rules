rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives & Role Authorization ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    function isDeveloperEmail() {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email != null && request.auth.token.email.lower() == 'pendyaladarshit4@gmail.com';
    }

    function isSuperAdmin() { 
      return isSignedIn() && (
        isDeveloperEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isAdmin() { 
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Users ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'selectedTheme', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 200 &&
             data.role in ['user', 'teacher', 'admin', 'super_admin', 'plus'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().role in ['user', 'plus'] || isDeveloperEmail()
      );
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phoneNumber', 'profilePhoto', 'customProfilePhoto', 'providerPhoto', 'selectedTheme', 'preferences', 'defaultPaperSettings', 'lastLogin'])) ||
                       (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'subscriptionTier', 'isPlusSubscriber', 'subscriptionDetails']) && !(existing().email.lower() == 'pendyaladarshit4@gmail.com' && incoming().role != 'super_admin')) ||
                       (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'subscriptionTier', 'isPlusSubscriber', 'subscriptionDetails']) && incoming().role in ['user', 'teacher', 'admin', 'plus'] && existing().role != 'super_admin');
      allow delete: if isSuperAdmin() && !(existing().email.lower() == 'pendyaladarshit4@gmail.com');
    }

    // --- Papers ---
    function isValidPaper(data) {
      return data.keys().hasAll(['id', 'timestamp', 'config', 'title', 'answerKey', 'uid']) &&
             data.uid == request.auth.uid &&
             data.title is string && data.title.size() <= 300 &&
             isValidId(data.id);
    }

    match /papers/{paperId} {
      allow get: if isSignedIn() && (existing() == null || isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidPaper(incoming()) && isValidId(paperId);
      allow update: if isSignedIn() && isOwner(existing().uid) && incoming().uid == existing().uid;
      allow delete: if isSignedIn() && (isOwner(existing().uid) || isAdmin());
    }

    match /paperDetails/{detailId} {
      allow get: if isSignedIn() && (existing() == null || isOwner(existing().uid) || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().uid);
      allow update: if isSignedIn() && isOwner(existing().uid) && incoming().uid == existing().uid;
      allow delete: if isSignedIn() && (isOwner(existing().uid) || isAdmin());

      match /questions/{questionId} {
        allow read, write: if isSignedIn();
      }
    }

    // --- Question Banks ---
    function isValidBank(data) {
      return data.keys().hasAll(['id', 'subject', 'grade', 'lastUpdated', 'content', 'uid']) &&
             data.uid == request.auth.uid &&
             data.subject is string && data.subject.size() <= 100 &&
             isValidId(data.id);
    }

    match /banks/{bankId} {
      allow get: if isSignedIn() && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidBank(incoming()) && isValidId(bankId);
      allow update: if isSignedIn() && isOwner(existing().uid) && incoming().uid == existing().uid;
      allow delete: if isSignedIn() && (isOwner(existing().uid) || isAdmin());
    }

    // --- App Configuration (Maintenance Mode, Announcements, Model Registry) ---
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Admin Audit Logs ---
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // --- Security Events (Failed Logins, Security Alerts) ---
    match /security_events/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // --- AI Generation Metrics ---
    match /generation_metrics/{metricId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Curriculum (Syllabus) ---
    match /curriculum/{updateId} {
      allow read: if true; 
      allow write: if isAdmin();
    }
    
    // --- Legacy Support ---
    match /paperQuestions/{paperId}/questions/{questionId} {
      allow read, write: if isSignedIn(); 
    }
  }
}
