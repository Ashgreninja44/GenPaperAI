{
  "entities": {
    "GeneratedPaper": {
      "title": "GeneratedPaper",
      "description": "A generated question paper.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "number" },
        "config": { "type": "object" },
        "title": { "type": "string" },
        "questions": { "type": "array" },
        "answerKey": { "type": "string" },
        "uid": { "type": "string", "description": "The user ID of the owner." }
      },
      "required": ["id", "timestamp", "config", "title", "questions", "answerKey", "uid"]
    },
    "QuestionBank": {
      "title": "QuestionBank",
      "description": "A collection of questions for a specific subject/grade.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "board": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "lastUpdated": { "type": "number" },
        "content": { "type": "string" },
        "uid": { "type": "string", "description": "The user ID of the owner." }
      },
      "required": ["id", "subject", "grade", "lastUpdated", "content", "uid"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "customProfilePhoto": { "type": "string" },
        "providerPhoto": { "type": "string" },
        "selectedTheme": { "type": "string" },
        "preferences": {
          "type": "object",
          "properties": {
            "themeColor": { "type": "string" },
            "background": { "type": "string" }
          }
        },
        "provider": { "type": "string", "enum": ["google", "microsoft", "email", "phone"] },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" },
        "defaultPaperSettings": {
          "type": "object",
          "properties": {
            "board": { "type": "string" },
            "grade": { "type": "string" },
            "subject": { "type": "string" },
            "schoolName": { "type": "string" }
          }
        },
        "role": { "type": "string", "enum": ["user", "teacher", "admin", "super_admin", "plus"] },
        "subscriptionTier": { "type": "string", "enum": ["free", "plus"] },
        "isPlusSubscriber": { "type": "boolean" },
        "subscriptionDetails": { "type": "object" }
      },
      "required": ["uid", "name", "email", "selectedTheme", "createdAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application configuration such as maintenance mode, announcements, AI model registry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" },
        "message": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "dismissible": { "type": "boolean" },
        "models": { "type": "array" },
        "defaultModel": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable log of privileged administrative actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminUid": { "type": "string" },
        "action": { "type": "string" },
        "targetResource": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "adminEmail", "action", "timestamp"]
    },
    "SecurityEvent": {
      "title": "SecurityEvent",
      "description": "Log of security-related events like failed login attempts and role modifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "provider": { "type": "string" },
        "identifier": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "number" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
      },
      "required": ["id", "eventType", "timestamp", "severity"]
    },
    "GenerationMetric": {
      "title": "GenerationMetric",
      "description": "Aggregate metadata of AI paper generation events for analytics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "number" },
        "durationMs": { "type": "number" },
        "modelUsed": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "board": { "type": "string" },
        "testType": { "type": "string" },
        "totalMarks": { "type": "number" },
        "status": { "type": "string", "enum": ["success", "failure"] },
        "error": { "type": "string" },
        "usedWebExtract": { "type": "boolean" },
        "usedQuestionBank": { "type": "boolean" },
        "usedDiagrams": { "type": "boolean" },
        "uid": { "type": "string" }
      },
      "required": ["id", "timestamp", "durationMs", "status"]
    },
    "CurriculumUpdate": {
      "title": "CurriculumUpdate",
      "description": "Dynamic syllabus updates fetched via AI.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "board": { "type": "string" },
        "version": { "type": "string" },
        "data": { "type": "object", "description": "The structured syllabus data (Grade -> Subject -> Chapters[])" },
        "lastUpdated": { "type": "number" },
        "source": { "type": "string" }
      },
      "required": ["id", "board", "version", "data", "lastUpdated"]
    }
  },
  "firestore": {
    "/app_config/{configId}": {
      "schema": "AppConfig",
      "description": "Global system configuration like maintenance mode, announcements, AI model registry."
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Privileged admin audit trail."
    },
    "/security_events/{eventId}": {
      "schema": "SecurityEvent",
      "description": "Security events and login failures."
    },
    "/generation_metrics/{metricId}": {
      "schema": "GenerationMetric",
      "description": "AI generation performance and usage metrics."
    },
    "/papers/{paperId}": {
      "schema": "GeneratedPaper",
      "description": "User's generated question papers."
    },
    "/banks/{bankId}": {
      "schema": "QuestionBank",
      "description": "User's question banks."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data."
    },
    "/curriculum/{updateId}": {
      "schema": "CurriculumUpdate",
      "description": "Dynamic syllabus updates fetched via AI."
    }
  }
}
